.class public final Lim1;
.super Lt9;


# instance fields
.field public g:I

.field public h:I


# direct methods
.method public constructor <init>(II)V
    .locals 0

    invoke-direct {p0, p1}, Lt9;-><init>(I)V

    iput p2, p0, Lim1;->g:I

    const/4 p1, 0x0

    iput p1, p0, Lim1;->h:I

    return-void
.end method
